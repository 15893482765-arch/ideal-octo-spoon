# 沁爽饮料分销管理平台 · 环境变量模板
# 复制为 .env 后修改；.env 不入库（红线：不提交真实账号、源表密码或对象存储密钥）
# 本文件所有值均为占位示例，不是真实凭据。

# ===== PostgreSQL 16 + PostGIS（infra/docker-compose.yml 与后端共用）=====
POSTGRES_USER=qinshuang
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=qinshuang
DATABASE_URL=postgresql+asyncpg://qinshuang:change-me-strong-password@localhost:5432/qinshuang

# ===== Redis（缓存/幂等/分布式锁）=====
REDIS_URL=redis://localhost:6379/0

# ===== S3 兼容对象存储（本地 MinIO；合同、照片、凭证）=====
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=change-me-minio-user
S3_SECRET_KEY=change-me-minio-password
S3_BUCKET=qinshuang

# ===== 应用 =====
ENVIRONMENT=dev
SECRET_KEY=change-me-generate-a-long-random-string
DEMO_DATA_ENABLED=false
LOG_LEVEL=INFO
