# 沁爽饮料分销管理平台 · 环境变量模板
# 复制为 .env 后修改；.env 不入库（红线：不提交真实账号、源表密码或对象存储密钥）
# 本文件所有值均为占位示例，不是真实凭据。

# ===== PostgreSQL 16 + PostGIS（infra/docker-compose.yml 与后端共用）=====
POSTGRES_USER=qinshuang
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=qinshuang
DATABASE_URL=postgresql+asyncpg://qinshuang:change-me-strong-password@localhost:5432/qinshuang

# ===== Redis（缓存/幂等/分布式锁）=====
REDIS_URL=redis://localhost:6379/0

# ===== S3 兼容对象存储（本地 MinIO；合同、照片、凭证）=====
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=change-me-minio-user
S3_SECRET_KEY=change-me-minio-password
S3_BUCKET=qinshuang

# ===== 应用 =====
ENVIRONMENT=dev
SECRET_KEY=change-me-generate-a-long-random-string
DEMO_DATA_ENABLED=false
LOG_LEVEL=INFO

# ===== 生产部署（infra/docker-compose.yml，T30）=====
# 生产镜像标签（由发布流水线构建，非 root、无内联密钥）
API_IMAGE=qinshuang-backend:t30
API_PORT=8000

# 首任系统管理员：仅空库首次部署时置 INITIAL_ADMIN_BOOTSTRAP=true；
# 上线后必须移除 INITIAL_ADMIN_PASSWORD 并重启 api（首登强制改密）。
INITIAL_ADMIN_BOOTSTRAP=false
INITIAL_ADMIN_USERNAME=deployadmin
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_DISPLAY_NAME=部署管理员

# ===== 备份 / 灾备（T29）=====
BACKUP_DIR=/data/backups/qinshuang
BACKUP_RETENTION_DAYS=30
DR_DATABASE_URL=postgresql+psycopg2://qinshuang:change-me-strong-password@localhost:5432/qinshuang_dr

# ===== AI chat model (OpenAI-compatible; mock = deterministic fallback) =====
# 可选 provider：mock | moonshot | openai（后两者都走 Chat Completions，
# 换厂商只需改 AI_BASE_URL / AI_MODEL / AI_API_KEY）
AI_CHAT_PROVIDER=mock
AI_MODEL=deepseek-flash
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_CHAT_TIMEOUT_SECONDS=25

# ===== Qdrant 语义检索（Text2SQL L2，infra/docker-compose.yml 的 qdrant 服务）=====
# 关闭时检索器自动降级为语义层关键词匹配（低精度兜底，不阻断助手）。
QDRANT_ENABLED=true
QDRANT_URL=http://localhost:6333
# 语义索引变更后需重建：cd backend && python scripts/sync_semantic_index.py

# ===== Text2SQL 只读执行器 =====
TEXT2SQL_STATEMENT_TIMEOUT_MS=15000
TEXT2SQL_MAX_ROWS=1000
